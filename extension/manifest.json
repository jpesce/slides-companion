{
  "manifest_version": 3,
  "name": "__MSG_storeName__",
  "version": "1.0.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/presentation/*"],
      "exclude_matches": [
        "https://docs.google.com/presentation/*/present*",
        "https://docs.google.com/presentation/*/localpresent*"
      ],
      "js": ["live-edits-main.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://docs.google.com/presentation/*"],
      "exclude_matches": [
        "https://docs.google.com/presentation/*/present*",
        "https://docs.google.com/presentation/*/localpresent*"
      ],
      "js": [
        "settings.js",
        "messages.js",
        "i18n.js",
        "content.js",
        "menus.js",
        "illustrations.js",
        "settings-dialog.js",
        "companion.js",
        "spotlight.js",
        "scroll.js",
        "live-edits.js",
        "notes.js",
        "shortcuts.js"
      ],
      "css": ["companion.css", "settings-dialog.css", "spotlight.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://docs.google.com/presentation/*/present*",
        "https://docs.google.com/presentation/*/localpresent*"
      ],
      "js": ["live-edits-frame.js"],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://docs.google.com/presentation/*/present*",
        "https://docs.google.com/presentation/*/localpresent*"
      ],
      "js": [
        "settings.js",
        "messages.js",
        "i18n.js",
        "content.js",
        "menus.js",
        "zoom.js",
        "ink.js",
        "spotlight.js",
        "notes.js",
        "shortcuts.js"
      ],
      "css": ["spotlight.css", "zoom.css"],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": ["https://docs.google.com/presentation/*"],
      "match_about_blank": true,
      "js": ["settings.js", "messages.js", "i18n.js", "countdown.js"],
      "css": ["countdown.css"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["https://docs.google.com/presentation/*"],
  "optional_host_permissions": ["*://*/*"],
  "permissions": ["storage", "alarms", "scripting", "declarativeNetRequestWithHostAccess"],
  "web_accessible_resources": [
    {
      "resources": ["all-sites.html", "refused.html"],
      "matches": ["https://docs.google.com/*"]
    }
  ]
}
