{
  "manifest_version": 3,
  "name": "__MSG_storeName__",
  "version": "1.0.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/presentation/*"],
      "exclude_matches": [
        "https://docs.google.com/presentation/*/present*",
        "https://docs.google.com/presentation/*/localpresent*"
      ],
      "js": ["presenter-view-main.js", "live-edits-main.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://docs.google.com/presentation/*"],
      "exclude_matches": [
        "https://docs.google.com/presentation/*/present*",
        "https://docs.google.com/presentation/*/localpresent*"
      ],
      "js": [
        "settings.js",
        "messages.js",
        "i18n.js",
        "content.js",
        "slides-dom.js",
        "ui.js",
        "menus.js",
        "illustrations.js",
        "settings-dialog.js",
        "companion-drawing.js",
        "companion.js",
        "stage.js",
        "spotlight.js",
        "scroll.js",
        "live-edits.js",
        "notes.js",
        "presenter-view.js",
        "shortcuts.js"
      ],
      "css": [
        "palette.css",
        "companion.css",
        "settings-dialog.css",
        "spotlight.css",
        "live-edits.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://docs.google.com/presentation/*/present*",
        "https://docs.google.com/presentation/*/localpresent*"
      ],
      "js": ["presenter-view-main.js", "live-edits-frame.js"],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://docs.google.com/presentation/*/present*",
        "https://docs.google.com/presentation/*/localpresent*"
      ],
      "js": [
        "settings.js",
        "messages.js",
        "i18n.js",
        "content.js",
        "slides-dom.js",
        "ui.js",
        "menus.js",
        "zoom.js",
        "ink.js",
        "stage.js",
        "links.js",
        "spotlight.js",
        "notes.js",
        "presenter-view.js",
        "shortcuts.js"
      ],
      "css": ["palette.css", "spotlight.css", "zoom.css"],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": ["https://docs.google.com/presentation/*"],
      "match_about_blank": true,
      "js": ["settings.js", "messages.js", "i18n.js", "ui.js", "countdown.js"],
      "css": ["palette.css", "countdown.css"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["https://docs.google.com/presentation/*"],
  "optional_host_permissions": ["*://*/*"],
  "permissions": ["storage", "alarms", "scripting", "declarativeNetRequestWithHostAccess"],
  "web_accessible_resources": [
    {
      "resources": ["all-sites.html", "refused.html"],
      "matches": ["https://docs.google.com/*"]
    }
  ]
}
