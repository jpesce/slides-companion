{
  "manifest_version": 3,
  "name": "Slides Companion",
  "version": "0.0.1",
  "description": "Presenter tools for Google Slides.",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/presentation/*"],
      "exclude_matches": ["https://docs.google.com/presentation/*/present*", "https://docs.google.com/presentation/*/localpresent*"],
      "js": ["live-edits-main.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://docs.google.com/presentation/*"],
      "exclude_matches": ["https://docs.google.com/presentation/*/present*", "https://docs.google.com/presentation/*/localpresent*"],
      "js": ["settings.js", "content.js", "illustrations.js", "settings-dialog.js", "companion.js", "spotlight.js", "scroll.js", "live-edits.js", "notes.js"],
      "css": ["companion.css", "settings-dialog.css", "spotlight.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://docs.google.com/presentation/*/present*", "https://docs.google.com/presentation/*/localpresent*"],
      "js": ["live-edits-frame.js"],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": ["https://docs.google.com/presentation/*/present*", "https://docs.google.com/presentation/*/localpresent*"],
      "js": ["settings.js", "content.js", "zoom.js", "ink.js", "spotlight.js", "countdown.js", "notes.js"],
      "css": ["spotlight.css", "zoom.css", "countdown.css"],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": ["https://docs.google.com/presentation/*"],
      "match_about_blank": true,
      "js": ["settings.js", "countdown.js"],
      "css": ["countdown.css"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["https://docs.google.com/presentation/*"],
  "optional_host_permissions": ["*://*/*"],
  "permissions": ["storage", "alarms", "scripting", "declarativeNetRequestWithHostAccess"],
  "web_accessible_resources": [
    {
      "resources": ["all-sites.html"],
      "matches": ["https://docs.google.com/*"]
    }
  ]
}
