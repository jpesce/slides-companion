{
  "manifest_version": 3,
  "name": "Slides Companion",
  "version": "0.0.1",
  "description": "Presenter tools for Google Slides.",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/presentation/*"],
      "js": ["content.js", "companion.js"],
      "css": ["companion.css"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["https://docs.google.com/presentation/*"],
  "permissions": ["storage", "alarms"]
}
