{
  "name": "slides-companion",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "chromium": "node scripts/chromium.mjs",
    "demo": "node scripts/demo/stills.mjs && node scripts/demo/icon.mjs",
    "demo:finish": "node scripts/demo/sound.mjs && node scripts/demo/finish.mjs",
    "demo:record": "node scripts/demo/record.mjs && node scripts/demo/ae.mjs",
    "illustrations": "node scripts/build-illustrations.mjs",
    "brand": "node scripts/build-brand.mjs",
    "messages": "node scripts/build-messages.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint --fix .",
    "test": "npm run lint && playwright test",
    "test:offline": "playwright test --grep @offline",
    "test:build": "npm run build && node scripts/release.mjs testing && EXTENSION_PATH=build/slides-companion playwright test && node scripts/release.mjs tested",
    "test:headed": "playwright test --headed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.14.0",
    "eslint-plugin-playwright": "^2.12.2",
    "globals": "^17.14.0",
    "prettier": "^3.9.10"
  },
  "overrides": {
    "minimatch": "^11.0.5"
  }
}
