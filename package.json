{
  "name": "slides-companion",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "chromium": "node scripts/chromium.mjs",
    "demo": "node scripts/demo/record.mjs && node scripts/demo/edit.mjs",
    "illustrations": "node scripts/build-illustrations.mjs",
    "messages": "node scripts/build-messages.mjs",
    "test": "playwright test",
    "test:build": "npm run build && node scripts/release.mjs testing && EXTENSION_PATH=build/slides-companion playwright test && node scripts/release.mjs tested",
    "test:headed": "playwright test --headed"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
