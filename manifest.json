{
  "manifest_version": 3,
  "name": "Spotlight for Google Slides™",
  "version": "0.1.2",
"description": "Enhance your Google Slides workflow — zoom in on images with one tap and edit slides while presenting.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/presentation/*"
      ],
      "js": [
        "modules/options.js",
        "modules/logging.js",
        "modules/imageZoom.js",
        "editableSlideshow.js",
        "imageSpotlightForGoogleSlides.js"
      ],
      "css": [
        "styles.css"
      ]
    }
  ],
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
